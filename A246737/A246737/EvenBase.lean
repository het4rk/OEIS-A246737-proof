import A246737.Step

/-!
# Linear forms for even k (generated by `gen/gen_even2.py`)

Each form `Ge i` is `lin (ge i k)` for an explicit coefficient vector; one step of the
recursion acts on coefficient vectors by `pull`, so every chain lemma reduces to 35
univariate polynomial identities in `k`.
-/

set_option maxHeartbeats 4000000
set_option maxRecDepth 200000

namespace A246737

/-- Horner evaluation of a coefficient list (constant term first) -/
def ev : List ℤ → ℤ → ℤ
  | [], _ => 0
  | a :: l, k => a + k * ev l k

/-- the linear form with coefficient vector `c` (stored as an `St`) -/
def lin (c : St) (v : St) : ℤ :=
  c.t0 * v.t0 + c.t1 * v.t1 + c.t2 * v.t2 + c.t3 * v.t3 + c.t4 * v.t4 + c.t5 * v.t5 + c.t6 * v.t6 + c.t7 * v.t7 + c.t8 * v.t8 + c.t9 * v.t9 + c.t10 * v.t10 + c.t11 * v.t11 + c.t12 * v.t12 + c.t13 * v.t13 + c.t14 * v.t14 + c.t15 * v.t15 + c.t16 * v.t16 + c.t17 * v.t17 + c.t18 * v.t18 + c.t19 * v.t19 + c.t20 * v.t20 + c.t21 * v.t21 + c.t22 * v.t22 + c.t23 * v.t23 + c.t24 * v.t24 + c.t25 * v.t25 + c.t26 * v.t26 + c.t27 * v.t27 + c.t28 * v.t28 + c.t29 * v.t29 + c.t30 * v.t30 + c.t31 * v.t31 + c.t32 * v.t32 + c.t33 * v.t33 + c.t34 * v.t34

/-- componentwise sum -/
def addS (a b : St) : St :=
  ⟨a.t0 + b.t0, a.t1 + b.t1, a.t2 + b.t2, a.t3 + b.t3, a.t4 + b.t4, a.t5 + b.t5, a.t6 + b.t6, a.t7 + b.t7, a.t8 + b.t8, a.t9 + b.t9, a.t10 + b.t10, a.t11 + b.t11, a.t12 + b.t12, a.t13 + b.t13, a.t14 + b.t14, a.t15 + b.t15, a.t16 + b.t16, a.t17 + b.t17, a.t18 + b.t18, a.t19 + b.t19, a.t20 + b.t20, a.t21 + b.t21, a.t22 + b.t22, a.t23 + b.t23, a.t24 + b.t24, a.t25 + b.t25, a.t26 + b.t26, a.t27 + b.t27, a.t28 + b.t28, a.t29 + b.t29, a.t30 + b.t30, a.t31 + b.t31, a.t32 + b.t32, a.t33 + b.t33, a.t34 + b.t34⟩

/-- scalar multiple -/
def smulS (x : ℤ) (a : St) : St :=
  ⟨x * a.t0, x * a.t1, x * a.t2, x * a.t3, x * a.t4, x * a.t5, x * a.t6, x * a.t7, x * a.t8, x * a.t9, x * a.t10, x * a.t11, x * a.t12, x * a.t13, x * a.t14, x * a.t15, x * a.t16, x * a.t17, x * a.t18, x * a.t19, x * a.t20, x * a.t21, x * a.t22, x * a.t23, x * a.t24, x * a.t25, x * a.t26, x * a.t27, x * a.t28, x * a.t29, x * a.t30, x * a.t31, x * a.t32, x * a.t33, x * a.t34⟩

lemma lin_add (c d v : St) : lin (addS c d) v = lin c v + lin d v := by
  unfold lin addS; ring

lemma lin_smul (a : ℤ) (c v : St) : lin (smulS a c) v = a * lin c v := by
  unfold lin smulS; ring

